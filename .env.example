# Veritabanı — SQLite dosya yolu (sunucu gerekmez)
DATABASE_URL=sqlite:///./qa_tool.db

# Ollama — llama3 (yerel, kurulum: https://ollama.com)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3

# Cloudflare Browser Rendering (opsiyonel — yoksa Playwright kullanılır)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Genel
DEBUG=true
MAX_PAGES_PER_CRAWL=30
